_GFX_GIRL_1","source_id":2,"local_id":2,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_WANDER_AROUND","elevation":3,"initially_hidden":false,"name":"居民","lines":["The ground absorbs rainwater, and trees grow by drinking that water…\nOur FORTREE CITY exists because there's both water and soil."]},{"at":[32,10],"source_script":"FortreeCity_EventScript_Woman","source_flag":"0","source_gfx":"OBJ_EVENT_GFX_WOMAN_5","source_id":3,"local_id":3,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_WANDER_UP_AND_DOWN","elevation":3,"initially_hidden":false,"name":"居民","lines":["I want to go to the POKéMON GYM, but something's blocking the way.\nAfter all the bother I went through training on ROUTE 120…"]},{"at":[11,14],"source_script":"FortreeCity_EventScript_Boy","source_flag":"0","source_gfx":"OBJ_EVENT_GFX_BOY_1","source_id":4,"local_id":4,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_LOOK_AROUND","elevation":4,"initially_hidden":false,"name":"居民","lines":["Living on top of trees is okay.\nBut sometimes BUG POKéMON come in through windows. It can be really startling."]},{"at":[8,10],"source_script":"FortreeCity_EventScript_OldMan","source_flag":"0","source_gfx":"OBJ_EVENT_GFX_OLD_MAN","source_id":5,"local_id":5,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_LOOK_AROUND","elevation":3,"initially_hidden":false,"name":"居民","lines":["The CITY consists of homes built on trees.\nPerhaps because of that lifestyle, everyone is healthy and lively.\nWhy, even myself--I feel as if I've grown thirty years younger."]},{"at":[9,16],"source_script":"FortreeCity_EventScript_GameboyKid","source_flag":"0","source_gfx":"OBJ_EVENT_GFX_GAMEBOY_KID","source_id":6,"local_id":6,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_FACE_DOWN","elevation":3,"initially_hidden":false,"name":"居民","lines":["There are POKéMON that evolve when you trade them! That's what I heard."]},{"at":[25,8],"source_script":"FortreeCity_EventScript_Kecleon","source