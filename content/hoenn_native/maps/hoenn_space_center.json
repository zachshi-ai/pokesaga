E_CENTER_1F_WOMAN","facing":"down","movement":"MOVEMENT_TYPE_WANDER_UP_AND_DOWN","elevation":3,"initially_hidden":false,"name":"居民","lines":["TEAM AQUA should take care of TEAM MAGMA!\nBut if they did that, TEAM AQUA will become bold and brazen, won't they?"]},{"at":[12,9],"source_script":"MossdeepCity_SpaceCenter_1F_EventScript_Grunt3","source_flag":"FLAG_HIDE_MOSSDEEP_CITY_SPACE_CENTER_1F_TEAM_MAGMA","source_gfx":"OBJ_EVENT_GFX_MAGMA_MEMBER_F","source_id":6,"local_id":6,"source_local":"","facing":"left","movement":"MOVEMENT_TYPE_FACE_LEFT","elevation":3,"initially_hidden":true,"name":"Grunt","lines":["Don't think you're on a roll just because you've beaten me!"],"source_trainer":"TRAINER_GRUNT_SPACE_CENTER_3","battle":{"team":[{"species":41,"level":31},{"species":261,"level":31}]}},{"at":[11,6],"source_script":"MossdeepCity_SpaceCenter_1F_EventScript_Grunt1","source_flag":"FLAG_HIDE_MOSSDEEP_CITY_SPACE_CENTER_1F_TEAM_MAGMA","source_gfx":"OBJ_EVENT_GFX_MAGMA_MEMBER_M","source_id":7,"local_id":7,"source_local":"","facing":"left","movement":"MOVEMENT_TYPE_FACE_LEFT","elevation":3,"initially_hidden":true,"name":"Grunt","lines":["Okay, I get it already! The next time, we'll come unannounced."],"source_trainer":"TRAINER_GRUNT_SPACE_CENTER_1","battle":{"team":[{"species":322,"level":32}]}},{"at":[10,2],"source_script":"MossdeepCity_SpaceCenter_1F_EventScript_Grunt4","source_flag":"FLAG_HIDE_MOSSDEEP_CITY_SPACE_CENTER_1F_TEAM_MAGMA","source_gfx":"OBJ_EVENT_GFX_MAGMA_MEMBER_M","source_id":8,"local_id":8,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_FACE_DOWN","elevation":3,"initially_hidden":true,"name":"Grunt","lines":["What are we going to do with the rocket fuel?\nHow would I know? Ask our leader upstairs!"],"source_trainer":"TRAINER_GRUNT_SPACE_CENTER_4","battle":{"team":[{"species":343,"level":32}]}},{"at":[13,2],"source_script":"MossdeepCity_SpaceCenter_1F_EventScript_Grunt2","source_flag":"FLAG_HIDE_MOSSDEEP_CITY_SPACE_CENTER_1F_TEAM_MAGMA","source_gfx":"OBJ_EVENT_GFX_MAGMA_MEMBER_M","source_id":9,"local_id":9,"source_local":"LOCALID_SPACE_CENTER_1F_STAIR_GRUNT","facing":"down","movement":"MOVEMENT_TYPE_FACE_DOWN","elevation":3,"initially_hidden":true,"name":"Grunt","lines":["Our leader said no one, but no one, gets past me!"],"source_trainer":"TRAINER_GRUNT_SPACE_CENTER_2","battle":{"team":[{"species":262,"level":26},{"species":262,"level":28},{"species":322,"level":30}]}},{"at":[2,5],"source_script":"MossdeepCity_SpaceCenter_1F_EventScript_MagmaNote","source_flag":"FLAG_HIDE_MOSSDEEP_CITY_SPACE_CENTER_MAGMA_NOTE","source_gfx":"OBJ_EVENT_GFX_NINJA_BOY","source_id":10,"local_id":10,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_INVISIBLE","elevation":0,"initially_hidden":false,"name":"居民","lines":["This is… An intent-to-steal notice?\n“To the staff of the SPACE CENTER: How are you? We are doing fine.\n“We will soon visit you to take your rocket fuel.\n“Please don't try to stop us. We will take the fuel no matter what.\n“Let there be more land!                                           TEAM MAGMA”"]},{"at":[1,4],"source_script":"MossdeepCity_SpaceCenter_1F_EventScript_Steven","source_flag":"FLAG_HIDE_MOSSDEEP_CITY_SPACE_CENTER_1F_STEVEN","source_gfx":"OBJ_EVENT_GFX_STEVEN","source_id":11,"local_id":11,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_FACE_DOWN","elevation":3,"initially_hidden":false,"name":"大吾","lines":["STEVEN: 小悠, have you read that proclamation already?\nTEAM MAGMA is coming after the rocket fuel on this island.\nI don't know what they'd need it for, but they can't be allowed to take it.\nI'll keep an eye on things for a while longer.\nIn the meantime, why don't you go check out the town?"]}],"objects":[],"warps":[{"at":[7,9],"trigger":"down","to":{"region":"hoenn","map":"hoenn_mossdeep","at":[64,16],"hoenn_native":true,"arrival_from":[64,15],"facing":"down"},"source_warp":0},{"at":[8,9],"trigger":"down","to":{"region":"hoenn","map":"hoenn_mossdeep","at":[64,16],"hoenn_na