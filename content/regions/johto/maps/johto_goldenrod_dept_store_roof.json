{"name": "满金百货·Roof", "emerald": "johto_goldenrod_dept_store_roof", "size": [8, 4], "spawn": [4, 2], "npcs": [{"at": [1, 1], "name": "店员", "gfx": "clerk", "lines": ["欢迎光临，随便看看。", "货都在货架上，别客气。"]}, {"at": [5, 1], "name": "宝可梦迷", "gfx": "old_woman", "lines": ["我年轻的时候，也到处跑。", "现在腿脚不行了，就在这里看风景。"]}, {"at": [1, 0], "name": "钓鱼人", "gfx": "sailor", "lines": ["海风今天不错。", "船期？看天，也看运气。"]}, {"at": [1, 2], "name": "双胞胎", "gfx": "lass", "lines": ["这条路我闭着眼都能走。", "听说北边的塔里住着传说中的宝可梦。", "天快黑了，早点回去吧。"]}, {"at": [6, 2], "name": "理科男", "gfx": "scientist", "lines": ["研究数据是不会骗人的。", "宝可梦的行为比人想的复杂得多。"]}, {"at": [3, 0], "name": "宝可梦迷", "gfx": "man", "lines": ["哟，眼生得很啊。", "城都这地方，慢慢逛才有味道。", "出远门记得带足伤药。"]}, {"at": [2, 1], "name": "老师", "gfx": "lass", "lines": ["这条路我闭着眼都能走。", "听说北边的塔里住着传说中的宝可梦。", "天快黑了，早点回去吧。"]}, {"at": [0, 3], "name": "捕虫少年", "gfx": "bug_catcher", "lines": ["虫子是最棒的！", "草丛里能碰到不少好东西。"]}], "warps": [{"at": [5, 2], "to": {"region": "johto", "map": "johto_goldenrod_dept_store_6f", "at": [6, 1]}}, {"kind": "elevator", "at": [3, 2], "to": {"region": "johto", "map": "johto_goldenrod_dept_store_elevator", "at": [1, 1]}}], "encounters": [], "encounter_rate": 0.0, "objects": [{"at": [3, 2], "kind": "elevator", "sprite": "sign", "text": "电梯"}], "weather": "", "weather_name": "", "cycling": false}