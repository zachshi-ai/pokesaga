source_local":"","facing":"left","movement":"MOVEMENT_TYPE_FACE_LEFT","elevation":3,"initially_hidden":false,"name":"居民","lines":["I always wanted a SEEDOT, and I'm finally getting one!"]},{"at":[3,8],"source_script":"RustboroCity_PokemonSchool_EventScript_RichBoy","source_flag":"0","source_gfx":"OBJ_EVENT_GFX_RICH_BOY","source_id":3,"local_id":3,"source_local":"","facing":"up","movement":"MOVEMENT_TYPE_FACE_UP","elevation":3,"initially_hidden":false,"name":"居民","lines":["POKéMON can hold items, but they don't know what to do with man-made items like POTION and ANTIDOTE."]},{"at":[10,8],"source_script":"RustboroCity_PokemonSchool_EventScript_Lass","source_flag":"0","source_gfx":"OBJ_EVENT_GFX_LASS","source_id":4,"local_id":4,"source_local":"","facing":"up","movement":"MOVEMENT_TYPE_FACE_UP","elevation":3,"initially_hidden":false,"name":"居民","lines":["You know how some POKéMON moves can confuse a POKéMON?\nA confused POKéMON will sometimes attack itself without meaning to.\nBut once it leaves battle, it will return to normal."]},{"at":[3,6],"source_script":"RustboroCity_PokemonSchool_EventScript_SchoolKidM","source_flag":"0","source_gfx":"OBJ_EVENT_GFX_SCHOOL_KID_M","source_id":5,"local_id":5,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_FACE_DOWN","elevation":3,"initially_hidden":false,"name":"居民","lines":["A POKéMON holding a BERRY will heal itself…\nThere are many kinds of items that POKéMON can hold…\nBoy, it sure is hard taking notes down…"]},{"at":[5,3],"source_script":"RustboroCity_PokemonSchool_EventScript_Teacher","source_flag":"0","source_gfx":"OBJ_EVENT_GFX_GENTLEMAN","source_id":6,"local_id":6,"source_local":"","facing":"down","movement":"MOVEMENT_TYPE_FACE_DOWN","elevation":3,"initially_hidden":false,"name":"居民","lines":["Students who don't study get a little taste of my QUICK CLAW.\nWhether or not you are a good student  will be evident from the way you use this item."]},{"at":[0,10],"source_script":"RustboroCity_PokemonSchool_EventScript_Scott","source_flag":"FLAG_HIDE_RUSTBORO_CITY_POKEMON_SCHOOL_SCOTT","source_gfx":"OBJ_EVENT_GFX_SCOTT","source_id":7,"local_id":7,"source_local":"","facing":"up","movement":"MOVEMENT_TYPE_FACE_UP","elevation":0,"initially_hidden":false,"name":"居民","lines":["Hello? Didn't we meet before? I think back in PETALBURG CITY.\nLet me introduce myself. My name's SCOTT.\nI've been traveling everywhere in search of outstanding TRAINERS.\nMore specifically, I'm looking for POKéMON battle experts.\nSo, what brings you to this SCHOOL? Are you a TRAINER, too?\nThe first thing you should do is to have a POKéMON learn the move CUT.\nIf I remember correctly, someone in this town has CUT."]}],"objects":[{"at":[5,2],"source_script":"RustboroCity_PokemonSchool_EventScript_Blackboard","kind":"sign","native_fixture":true,"text":"The blackboard lists status changes that may affect POKéMON in battle."},{"at":[4,2],"source_script":"RustboroCity_PokemonSchool_EventScript_Blackboard","kind":"sign","native_fixture":true,"text":"The blackboard lists status changes that may affect POKéMON in battle."},{"at":[6,2],"source_script":"RustboroCity_PokemonSchool_EventScript_Blackboard","kind":"sign","native_fixture":true,"text":"The blackboard lists status changes that may affect POKéMON in battle."},{"at":[7,2],"source_script":"RustboroCity_PokemonSchool_EventScript_Blackboard","kind":"sign","native_fixture":true,"text":"The blackboard lists status changes that may affect POKéMON in battle."},{"at":[3,5],"source_script":"RustboroCity_PokemonSchool_EventScript_StudentNotebook","kind":"sign","native_fixture":true,"text":"It's this student's notebook…\nPOKéMON are to be caught using POKé BALLS.\nUp to six POKéMON can accompany a TRAINER.\nA TRAINER is someone who catches POKéMON, raises them, and battles with them.\nA TRAINER's mission is to defeat the strong TRAINERS who await challengers in POKéMON GYMS."}],"warps":[{"at":[5,10],"trigger":"down","to":{"region":"hoenn","map":"hoenn_rustboro","at":[27,35],"hoenn_native":true,"arrival_from":[27,34],"facing":"down"},"source_warp":0},{"at":[6,10],"trigger":"down","to":{"region":"hoenn","map":"hoenn_rustboro","at":[27,35],"hoenn_native":true,"arrival_from":[27,34],"facing":"down"},"source_warp":1}],"coord_events":[],"allow_running":false,"allow_cycling":false}
